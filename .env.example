# Copy to .env (ignored by Git). Never commit actual credentials.
# Opt in: COMPOSE_PROFILES=localdb,observability; unset for external DB and no ELK.
COMPOSE_PROFILES=localdb
APP_ENV=prod
WEBAPP_PORT=8080
API_PORT=8000
MYSQL_PORT=3306
ES_PORT=9200
LOGSTASH_BEATS_PORT=5044
LOGSTASH_API_PORT=9600
KIBANA_PORT=5601
# If docker.elastic.co times out, use Elastic's same-version Docker Hub images:
# ELASTICSEARCH_IMAGE=elastic/elasticsearch:9.5.6
# LOGSTASH_IMAGE=elastic/logstash:9.5.6
# KIBANA_IMAGE=elastic/kibana:9.5.6
# FILEBEAT_IMAGE=elastic/filebeat:9.5.6
# Only the SPA is exposed publicly by default. Change the *_BIND variables deliberately.
WEBAPP_BIND=127.0.0.1
# Keep API_BASE_URL=/api so the SPA uses same-origin auth cookies.
API_BASE_URL=/api
# Set this to a PRIVATE URL with the exact password from MYSQL_PASSWORD_FILE,
# percent-encoding special characters. For external MySQL use its own URL.
# MySQL service uses dbapp:3306 regardless of MYSQL_PORT (a host-only mapping).
DATABASE_URL=mysql://finance:REPLACE_WITH_PASSWORD@dbapp:3306/finance?serverVersion=9.7.4&charset=utf8mb4
JWT_TTL=120
REFRESH_TOKEN_TTL=2592000
CORS_ALLOW_ORIGIN=
# Proxies allowed to set X-Forwarded-For (default private_ranges = webapp nginx).
# TRUSTED_PROXIES=10.0.0.0/8
# Host header allowlist (regexes, comma-separated); empty allows any Host.
# TRUSTED_HOSTS=^(localhost|127\.0\.0\.1)$$
# API container UID; must own the files in secrets/ (local setup sets id -u).
APP_UID=1000
# Local-only browser preview proxy that rewrites Host (exact URL, never production).
# LOCAL_PREVIEW_ORIGIN=http://127.0.0.1:43801
BUDGET_TOLERANCE_PCT=2.0
PORTFOLIO_TOLERANCE_PCT=2.0
# No admin is created without explicit credentials. Set both before first deploy.
SEED_ADMIN_EMAIL=
# Secrets file paths; create using `make secrets` and `make jwt-keys`.
APP_SECRET_FILE=./secrets/app_secret
MYSQL_PASSWORD_FILE=./secrets/mysql_password
MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql_root_password
ELASTIC_PASSWORD_FILE=./secrets/elastic_password
KIBANA_PASSWORD_FILE=./secrets/kibana_password
LOGSTASH_PASSWORD_FILE=./secrets/logstash_password
JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
SEED_ADMIN_PASSWORD_FILE=./secrets/seed_admin_password
