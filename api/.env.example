APP_ENV=dev
APP_DEBUG=0
APP_SECRET_FILE=/run/secrets/app_secret
DATABASE_URL="mysql://finance:change-me@127.0.0.1:3306/finance?serverVersion=8.4.0&charset=utf8mb4"
JWT_TTL=120
REFRESH_TOKEN_TTL=2592000
JWT_SECRET_KEY=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY=/run/secrets/jwt_public_key
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD_FILE=/run/secrets/seed_admin_password
# Comma-separated proxy IPs/CIDRs (or private_ranges) allowed to set X-Forwarded-For.
TRUSTED_PROXIES=
# Comma-separated host regexes, e.g. ^(localhost|127\.0\.0\.1)$ ; empty allows any Host.
TRUSTED_HOSTS=
