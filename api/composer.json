{
  "name": "finance/api",
  "description": "Finance manager HTTP API",
  "type": "project",
  "require": {
    "php": "^8.5",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "doctrine/dbal": "^4.4",
    "doctrine/doctrine-bundle": "^3.1",
    "doctrine/doctrine-migrations-bundle": "^3.7",
    "doctrine/orm": "^3.6",
    "firebase/php-jwt": "7.2.1",
    "symfony/console": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/http-kernel": "8.1.*",
    "symfony/routing": "8.1.*",
    "symfony/uid": "8.1.*",
    "symfony/yaml": "8.1.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "scripts": {"test": "php vendor/bin/phpunit"}
}
